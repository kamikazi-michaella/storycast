{
  "name": "storycast",
  "version": "1.0.0",
  "description": "An accessible three-page storytelling microsite built with semantic HTML, Sass and native media.",
  "private": true,
  "scripts": {
    "sass:dev": "sass --watch sass/main.scss css/main.css",
    "sass:build": "sass sass/main.scss css/main.css --style=compressed",
    "serve": "browser-sync start --server --no-notify --no-open --files \"**/*.html, css/**/*.css, js/**/*.js\"",
    "dev": "concurrently \"npm:sass:dev\" \"npm:serve\"",
    "build": "npm run sass:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "sass": "^1.105.2"
  }
}
